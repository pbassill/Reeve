# Manage server configuration (native deployment).
# Loaded by systemd via EnvironmentFile=/etc/manage/manage.env.
# Lines are KEY=VALUE — do NOT use shell quoting; systemd parses this directly.

# Public URL agents will reach. Must include the scheme.
MANAGE_PUBLIC_URL=https://manage.example.com

# Where the SQLite database and secret_key live.
MANAGE_DATA_DIR=/var/lib/manage

# Where the agent files (manage-agent.py, install.sh, manage-agent.service) live.
# install.sh sets this to /opt/manage/agent.
MANAGE_AGENT_DIR=/opt/manage/agent

# Local port the uvicorn process binds to (Caddy/nginx proxies to this).
MANAGE_PORT=8000

# Bootstrap admin. If MANAGE_ADMIN_PASSWORD is empty on first start,
# a random password is generated and written to
# $MANAGE_DATA_DIR/INITIAL_ADMIN_PASSWORD (mode 0600).
MANAGE_ADMIN_USER=admin
MANAGE_ADMIN_PASSWORD=

# Agent check-in interval in seconds.
MANAGE_CHECKIN_INTERVAL=30

# --- Optional: LDAP / Active Directory single-sign-on ---
# Leave MANAGE_LDAP_URL blank to disable LDAP.
#MANAGE_LDAP_URL=ldaps://ad.example.com
#MANAGE_LDAP_USE_SSL=true
#MANAGE_LDAP_BIND_DN=CN=ManageBind,OU=Service,DC=example,DC=com
#MANAGE_LDAP_BIND_PASSWORD=
#MANAGE_LDAP_USER_SEARCH_BASE=OU=Users,DC=example,DC=com
#MANAGE_LDAP_USER_FILTER=(sAMAccountName={username})
#MANAGE_LDAP_ADMIN_GROUP_DN=CN=Manage Admins,OU=Groups,DC=example,DC=com
