[Unit]
Description=reevectl — central Ubuntu fleet management server
Documentation=https://github.com/your-org/reevectl
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reevectl
Group=reevectl
EnvironmentFile=/etc/reevectl/reevectl.env
WorkingDirectory=/opt/reevectl/server
ExecStart=/opt/reevectl/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port ${REEVECTL_PORT} \
    --proxy-headers \
    --forwarded-allow-ips '*'
Restart=always
RestartSec=5
SuccessExitStatus=0 3
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/reevectl
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
