# reevectl server configuration (native deployment).
# Loaded by systemd via EnvironmentFile=/etc/reevectl/reevectl.env.
# Lines are KEY=VALUE — do NOT use shell quoting; systemd parses this directly.

# Public URL agents will reach. Must include the scheme.
REEVECTL_PUBLIC_URL=https://reevectl.example.com

# Where the SQLite database and secret_key live.
REEVECTL_DATA_DIR=/var/lib/reevectl

# Where the agent files (reevectl-agent.py, install.sh, reevectl-agent.service) live.
# install.sh sets this to /opt/reevectl/agent.
REEVECTL_AGENT_DIR=/opt/reevectl/agent

# Local port the uvicorn process binds to (Caddy/nginx proxies to this).
REEVECTL_PORT=8000

# Bootstrap admin. If REEVECTL_ADMIN_PASSWORD is empty on first start,
# a random password is generated and written to
# $REEVECTL_DATA_DIR/INITIAL_ADMIN_PASSWORD (mode 0600).
REEVECTL_ADMIN_USER=admin
REEVECTL_ADMIN_PASSWORD=

# Agent check-in interval in seconds.
REEVECTL_CHECKIN_INTERVAL=30

# --- Optional: LDAP / Active Directory single-sign-on ---
# Leave REEVECTL_LDAP_URL blank to disable LDAP.
#REEVECTL_LDAP_URL=ldaps://ad.example.com
#REEVECTL_LDAP_USE_SSL=true
#REEVECTL_LDAP_BIND_DN=CN=ReevectlBind,OU=Service,DC=example,DC=com
#REEVECTL_LDAP_BIND_PASSWORD=
#REEVECTL_LDAP_USER_SEARCH_BASE=OU=Users,DC=example,DC=com
#REEVECTL_LDAP_USER_FILTER=(sAMAccountName={username})
#REEVECTL_LDAP_ADMIN_GROUP_DN=CN=reevectl Admins,OU=Groups,DC=example,DC=com
