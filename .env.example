# Required: public hostname your fleet will reach. Caddy uses this to
# auto-issue a Let's Encrypt cert. Must point at this host's public IP.
MANAGE_DOMAIN=manage.example.com
MANAGE_PUBLIC_URL=https://manage.example.com

# First-run admin credentials. If MANAGE_ADMIN_PASSWORD is omitted, a random
# password is generated and written to /data/INITIAL_ADMIN_PASSWORD inside
# the manage container (read with: docker compose exec manage cat /data/INITIAL_ADMIN_PASSWORD).
MANAGE_ADMIN_USER=admin
# MANAGE_ADMIN_PASSWORD=changeme

# Agent check-in interval in seconds (lower = more responsive, more traffic).
MANAGE_CHECKIN_INTERVAL=30

# Optional LDAP / Active Directory single-sign-on for admin login.
# Leave MANAGE_LDAP_URL blank to disable LDAP and use only local accounts.
# MANAGE_LDAP_URL=ldaps://ad.example.com
# MANAGE_LDAP_USE_SSL=true
# MANAGE_LDAP_BIND_DN=CN=ManageBind,OU=Service,DC=example,DC=com
# MANAGE_LDAP_BIND_PASSWORD=changeme
# MANAGE_LDAP_USER_SEARCH_BASE=OU=Users,DC=example,DC=com
# MANAGE_LDAP_USER_FILTER=(sAMAccountName={username})
# Optional: only let members of this group log in.
# MANAGE_LDAP_ADMIN_GROUP_DN=CN=Manage Admins,OU=Groups,DC=example,DC=com
