# Required: public hostname your fleet will reach. Caddy uses this to
# auto-issue a Let's Encrypt cert. Must point at this host's public IP.
REEVECTL_DOMAIN=reevectl.example.com
REEVECTL_PUBLIC_URL=https://reevectl.example.com

# First-run admin credentials. If REEVECTL_ADMIN_PASSWORD is omitted, a random
# password is generated and written to /data/INITIAL_ADMIN_PASSWORD inside
# the reevectl container (read with: docker compose exec reevectl cat /data/INITIAL_ADMIN_PASSWORD).
REEVECTL_ADMIN_USER=admin
# REEVECTL_ADMIN_PASSWORD=changeme

# Agent check-in interval in seconds (lower = more responsive, more traffic).
REEVECTL_CHECKIN_INTERVAL=30

# Optional LDAP / Active Directory single-sign-on for admin login.
# Leave REEVECTL_LDAP_URL blank to disable LDAP and use only local accounts.
# REEVECTL_LDAP_URL=ldaps://ad.example.com
# REEVECTL_LDAP_USE_SSL=true
# REEVECTL_LDAP_BIND_DN=CN=ReevectlBind,OU=Service,DC=example,DC=com
# REEVECTL_LDAP_BIND_PASSWORD=changeme
# REEVECTL_LDAP_USER_SEARCH_BASE=OU=Users,DC=example,DC=com
# REEVECTL_LDAP_USER_FILTER=(sAMAccountName={username})
# Optional: only let members of this group log in.
# REEVECTL_LDAP_ADMIN_GROUP_DN=CN=reevectl Admins,OU=Groups,DC=example,DC=com
